# Public template: placeholders only. Copy outside the checkout, preferably to
# ~/.config/openweb-benchmark-news/.env; protect its directory (0700) and file (0600).
# The CLI loads only the explicitly selected --env-file for an approved live run.
# Leave unused providers unset. No generic vendor credential aliases are automatic.
OPENWEB_NEWS_GEMINI_API_KEY=
OPENWEB_NEWS_BRAVE_API_KEY=
OPENWEB_NEWS_BRIGHTDATA_API_KEY=
OPENWEB_NEWS_BRIGHTDATA_ZONE=
OPENWEB_NEWS_EXA_API_KEY=
OPENWEB_NEWS_FIRECRAWL_API_KEY=
OPENWEB_NEWS_LINKUP_API_KEY=
OPENWEB_NEWS_OXYLABS_API_KEY=
OPENWEB_NEWS_PARALLEL_API_KEY=
OPENWEB_NEWS_PERPLEXITY_API_KEY=
OPENWEB_NEWS_SEARLO_API_KEY=
OPENWEB_NEWS_TAVILY_API_KEY=
OPENWEB_NEWS_VALYU_API_KEY=
OPENWEB_NEWS_YOUCOM_API_KEY=
OPENWEB_NEWS_KEENABLE_API_KEY=
OPENWEB_NEWS_SELTZ_API_KEY=
OPENWEB_NEWS_SERPER_API_KEY=
OPENWEB_NEWS_SCAVIO_API_KEY=
